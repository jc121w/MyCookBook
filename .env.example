# Copy this file to .env and fill in the values. Never commit .env itself.

# PostgreSQL connection string (Prisma)
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Edamam recipe search: https://developer.edamam.com
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
EDAMAM_USER_ID=

# Optional social sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Photo uploads: https://uploadthing.com (V7 token)
UPLOADTHING_TOKEN=
